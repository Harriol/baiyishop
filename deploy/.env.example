# 百益商城 · 本地开发环境变量
# 用法：复制为 deploy/.env 后按需修改；.env 已被 .gitignore 忽略，不会进仓库。

# ---------- MySQL ----------
# 默认使用本机已安装的原生 MySQL 8.0（服务名 MySQL，监听 3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 仅当使用容器版 MySQL（--profile docker-mysql）时才有意义：容器映射到宿主 3307
MYSQL_CONTAINER_PORT=3307
# 仅容器版 MySQL 使用（--profile docker-mysql）；原生 MySQL 的密码在运行时用 -RootPassword 传入
MYSQL_ROOT_PASSWORD=Baiyi@ContainerRoot2026

# 六个 schema 各自的专用账号密码
# 依据 docs/adr/ADR-007：数据库账号按 schema 授权，从权限层阻止跨库访问
MYSQL_PWD_USER=Baiyi@User2026
MYSQL_PWD_PRODUCT=Baiyi@Product2026
MYSQL_PWD_INVENTORY=Baiyi@Inventory2026
MYSQL_PWD_ORDER=Baiyi@Order2026
MYSQL_PWD_PAYMENT=Baiyi@Payment2026
MYSQL_PWD_SECKILL=Baiyi@Seckill2026

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Nacos ----------
NACOS_PORT=8848

# ---------- RocketMQ ----------
ROCKETMQ_NAMESRV_PORT=9876

# ---------- Elasticsearch ----------
ES_PORT=9200

# ---------- MinIO ----------
MINIO_ROOT_USER=baiyishop
MINIO_ROOT_PASSWORD=Baiyi@Minio2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
